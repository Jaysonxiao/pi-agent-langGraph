# M8 provider resolver names. This file is documentation and is not auto-loaded.
# Copy it to a gitignored .env and pass --env-file .env explicitly when needed.
# PI_AGENT_PROVIDER: fake (default) or compatible
# PI_AGENT_MODEL: required for compatible; no default
# PI_AGENT_BASE_URL: required HTTP(S) API root for compatible; no default
# PI_AGENT_API_KEY_ENV: name of key variable; default PI_AGENT_API_KEY
# PI_AGENT_API_KEY: secret value; never put a real key in this file
# PI_AGENT_TIMEOUT_SECONDS: finite positive duration; default 30
# PI_AGENT_MAX_ATTEMPTS: positive integer including first attempt; default 3
# PI_AGENT_RUN_TIMEOUT_SECONDS: finite positive duration; default 120
# PI_AGENT_LIVE: set to 1 only for an explicit live smoke run
